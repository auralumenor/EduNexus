PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# Dev:  mongodb://127.0.0.1:27017/lms_db  (local or in-memory fallback)
# Prod: get a free cluster at https://cloud.mongodb.com
#       mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/lms_db
MONGO_URI=mongodb://127.0.0.1:27017/lms_db

# ── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 64
JWT_SECRET=change_this_before_deploying
JWT_EXPIRES_IN=7d

# ── URLs ───────────────────────────────────────────────────────────────────────
# The public URL of the deployed frontend (used in password reset emails)
# Dev:  http://localhost:3000
# Prod: https://edu-nexus-xi.vercel.app
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
# Dev:  leave empty (localhost origins are allowed automatically)
# Prod: https://edu-nexus-xi.vercel.app
ALLOWED_ORIGINS=

# ── Email ──────────────────────────────────────────────────────────────────────
# Leave empty in dev — falls back to console logging.
# For production set via Render dashboard Environment Variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME="EduNexus"
FROM_EMAIL="noreply@yourdomain.com"
