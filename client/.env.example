# ── API URL ────────────────────────────────────────────────────────────────────
# Dev:  leave unset — Vite proxy forwards /api/* to http://127.0.0.1:5000
#
# Prod: set this as an Environment Variable in the Vercel dashboard:
#   Key:   VITE_API_URL
#   Value: https://<your-render-app>.onrender.com/api
#
# This is baked into the JS bundle at build time by Vite.
# VITE_API_URL=https://<your-render-app>.onrender.com/api
